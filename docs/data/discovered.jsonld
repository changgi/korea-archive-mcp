a/subjects.jsonld#subject/South%20Korea"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/history"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/continuity%20and%20change"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/New%20Zealand%20participation"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Democratic%20Peoples%20Republic%20of%20Korea"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Republic%20of%20Korea"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/social%20sciences"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/China"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Soviet%20Union"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/United%20N"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/935a495d8aa5.html"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/q1YqVrKKVkrJq1KK1VEqUbJS8s4vSk3MUwhPLFJ41DBFwS-xJDM_LzFHwSczqSixqFIhP03BL7VcISo1MScxL-XQdse8ysDS1GKQqmIlHaUUoBGGlroGRrpGBkZmQIFMoICJkZmxoamJBZBbCuRmlJQUFFvp6yfmVRbCtOql55eV6OVV6ecCRXUT84rLU4uK9bPBjtEtTywCai0AavWLArpqFyFXgdWgOSwPqBvkTR2lXCALSBUCqdcb5rzatEbhdUfLmwWNCm9mT3gzbylQKhEUECD36xoa6hoZhxgaW5kYWJkaKNUCAA/manifest.json", "@type": "rico:Instantiation", "rico:title": "기록 봉투(이미지 없음 — 기록 정보만 담은 브리지)"}, "rico:scopeAndContent": "The Korean War was fought between North Korea (Democratic Peoples Republic of Korea) and South Korea (Republic of Korea). North Korea had the support of China and the Soviet Union. South Korea was supported by the United Nations, primarily the United States but also New Zealand. The war began in June 1950 and ended in July 1953. It is estimated that 2 million civilians and 1 million soldiers died in this conflict.", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:50Z", "prov:used": ["dnz"], "prov:endedAtTime": "2026-11-23T13:40:50Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://jsg.aks.ac.kr/dir/view?dataId=JSG_K2-2751", "@type": "rico:Record", "rico:title": "흥왕책봉의궤(興王冊封儀軌)", "rico:identifier": "K2-2751", "rico:isOrWasIncludedIn": {"@id": "set:jsg:四部 › 史部(K2)"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EA%B3%A0%EC%A2%85"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%9D%B4%EC%9E%AC%EB%A9%B4"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/cb52b3ce6829.html"}, "rico:isRelatedTo": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/r/70f394a61a87.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/9b68b9c12b33.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/7ebe9368533d.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/75302021d83c.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/619a9dcffc17.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/ec44494a4ad2.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '四部 › 史部(K2)'"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/q1YqVrKKVsoqTleK1VEqUbJSejt36ZuZU99sbH29pfPN3Bmvti3ReNHR8byv-2lb19MNjU9bGl7s7tFU0lFKASoGUplAyttI18jc1BDIKwXyMkpKCoqt9PWBhuolZhfrJSbrZRfpp2QW6ZdlppbbpySWJHqm2HoFu8cj9BUA9T2dPftl8wqFRw27FJ72bwIyNbyNQBblAeVADtRRyoVYWQikXm-Y82rTGoXXHS1vFjQqvJk94c28pUCpRJAXjAyMzHQNDXWNjEMMja1MDKxMDZRqAQ/manifest.json", "@type": "rico:Instantiation", "rico:title": "기록 봉투(이미지 없음 — 기록 정보만 담은 브리지)"}, "rico:scopeAndContent": "정의 고종 의 형 이재면 을 8월 興王으로 책봉하는 과정을 기록한 의궤이다. 서지사항표지 서명은 ‘興親王冊封儀軌 單’이며, 권수제는 ‘興王冊封儀軌’이다. 표지는 황색이며, 주황색 실을 사용하여 五針으로 장정한 線裝本으로, 후대에 개장한 것으로 보인다. 표지의 좌측에는 표지 서명이 기재되어 있다. 본문의 필사에는 四周雙邊 12행 烏絲欄, 上下向黑魚尾의 印札空冊紙가 사용되었다. 본문은 국한문을 혼용하여 작성하였다. 장서각에 동일한 서명의 책이 1부(K2-2750) 더 소장되어 있는데, 둘의 내용과 판식은 동일하나 이 책이 K2-2750에 비해 크기가 크다. 체제 및 내용K2-2750 참조. 범례 ●인명 ●관직명 ●나라명 ●건물명 ●관청명 ●지명 ●연도 ●문헌명 ●기관 (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:50Z", "prov:used": ["jsg"], "prov:endedAtTime": "2026-11-23T13:40:50Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#bf2d23d0c6529ef3"}]}}, {"@id": "https://jsg.aks.ac.kr/dir/view?dataId=JSG_K2-2841", "@type": "rico:Record", "rico:title": "존숭도감의궤(尊崇都監儀軌)", "rico:identifier": "K2-2841", "rico:isOrWasIncludedIn": {"@id": "set:jsg:四部 › 史部(K2)"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%9D%B8%EC%9B%90%EC%99%95%ED%9B%84"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%88%99%EB%B9%88"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%98%81%EC%A1%B0"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%A0%95%EC%84%B1%EC%99%95%ED%9B%84"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%E6%B7%91%E5%AC%AA"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EF%A7%A1%E5%A4%A9%E8%BC%94"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#person/%EC%A1%B0%EC%84%A0%20%EC%98%81%EC%A1%B0"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/s