co:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/awm/C2695153/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 이미지로 구축(KOREA ARCHIVE 브리지)"}, "rico:scopeAndContent": "The Last Post Ceremony is presented in the Commemorative area of the Australian War Memorial each day. The ceremony commemorates more than 102,000 Australians who have given their lives in war and other operations and whose names are recorded on the Roll of Honour. At each ceremony the story behind one of the names on the Roll of Honour is told. Hosted by Craig Berelle, the story for this day was ", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:44:36Z", "prov:used": ["awm"], "prov:endedAtTime": "2026-11-24T22:44:36Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#9d06a0584c21fb9e"}]}}, {"@id": "https://www.awm.gov.au/collection/C191658", "@type": "rico:Record", "rico:title": "1. UN invasion traps Reds in Korea 2. UN Allied Forces close giant trap on Korean Reds 3. Orient at the crossroads (Extr", "rico:identifier": "F03507", "rico:isOrWasIncludedIn": {"@id": "set:awm:AWM 유형 › Newsreel"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#form/Film"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#form/Newsreel"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#conflict/Korea%2C%201950-1953"}], "rico:hasCreator": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#creator/Movietone%20News"}], "rico:isAssociatedWithPlace": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Korea%3A%20Inchon"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Korea%3A%20Kimpo"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Korea%3A%20Pyongyang%20Area"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Pyongyang"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Korea%3A%20Taegu"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/da879f8a0e5c.html"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/awm/C191658/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 이미지로 구축(KOREA ARCHIVE 브리지)"}, "rico:scopeAndContent": "Extracts from Movietone News newsreels relating to the war in Korea September to October 1950. 1. (1 min 36 sec). Coverage of the landings at Inchon, Korea 15 September 1950 by the X US Corps. Shows the naval bombardment by rocket ships and battleships of Task Force 77. The landing by US marines. Fleeing Korean civilians and a UN refugee camp south of Taegu. Republic of Korea troops on the move. 2", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:44:36Z", "prov:used": ["awm"], "prov:endedAtTime": "2026-11-24T22:44:36Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#9d06a0584c21fb9e"}]}}, {"@id": "https://www.awm.gov.au/collection/C217592", "@type": "rico:Record", "rico:title": "[United Nations forces Korea 1957, 1958]", "rico:identifier": "F03606", "rico:isOrWasIncludedIn": {"@id": "set:awm:AWM 유형 › Home movie"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#form/Film"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#form/Home%20movie"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#conflict/Period%201950-1959"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#conflict/Korea%2C%201950-1953"}], "rico:hasCreator": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#creator/Unknown"}], "rico:isAssociatedWithPlace": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/China%3A%20Hong%20Kong"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Japan%3A%20Tokyo"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Korea%3A%2038th%20Parallel"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/Panmunjom"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/6b9da0f06e06.html"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/awm/C217592/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 이미지로 구축(KOREA ARCHIVE 브리지)"}, "rico:scopeAndContent": "Korea circa 1957-1958. [Reel 1]. Parade at a British Armoured unit with crews and Centurion tanks featured. Parade of United Nations forces at a military base. Flags indicate US, Greek, British and Turkish forces present. 'SAC Library' sign in the background. 'US 8th Army Band' on the side of the bass drum of the military band. Fly past of a formation of Sabre jets. An outdoor party with food cook", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:44:36Z", "prov:used": ["awm"], "prov:endedAtTime": "2026-11-24T22:44:36Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#9d06a0584c21fb9e"}]}}, {"@id": "https://www.awm.gov.au/collection/C190648", "@type": "rico:Record", "rico:title": "1 Battalion pre-embarkation parade, shipboard scenes, arrival in Korea DPR/S/10 · 권리:PD(저작권 만료)", "rico:identifier": "F07533", "rico:isOrWasIncludedIn": {"@id": "set:awm:AWM 유형 › To be confirmed"}, "rico:hasOrHadSubject": [{"@