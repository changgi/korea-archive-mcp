onld#place/%E6%85%B6%E5%B7%9E"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/%EA%B2%BD%EC%A3%BC"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/%EA%B2%BD%EC%83%81%EB%B6%81%EB%8F%84%20%EA%B2%BD%EC%A3%BC%EC%8B%9C"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#place/%EA%B2%BD%EC%A3%BC%EC%8B%9C"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/q1YqVrKKVsoqTleK1VEqUbJSerVp75vFe94sb3g7Y-rr_haNZ63bnm6f93TOhqd7Fz2dM01TSUcpBagMSGUCKW8jXRNTEyMgrxTIyygpKSi20tcHGqeXmF2sl5isl12kn5JZpF-WmVpun5JYkuiZYusV7B6P0FcA1Pd09uyXzSsUHjXsUnjavwnI1PA2AlmUB5QDOU1HKRdiZSGQer1hzqtNaxRed7S8WdCo8Gb2hDfzlgKlEkGONzIwMtM1NNQ1MgkxNLEyMbcyMFOqBQA/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "정의 조선총독부 육지측량부에서 1917년에 인쇄·발행한 축척 1:25,000의 慶州 지역 특수지형도이다. 서지사항 본문 지도에 ‘慶州 KYÖNG-JU’로 되어 있고, 표지서명은 ‘慶尙北道 慶州郡 慶州’이다. 표지 장황은 황색 종이에 斜格卍字 문양이 있는 것으로, 성인 손바닥만 한 크기이다. 표지서명은 사주쌍변의 검은색 테두리가 있는 흰색 제첨을 사용하였다. 현대식으로 인쇄한 지도 한 장을 세로 3절 가로 2절로 접어 摺鋪式으로 장정한 후에 빳빳한 표지를 붙여놓았다. 지도는 1:25,000 축척본으로 大正 6년에 발행한 것이다. 지도에 사용된 색상은 녹색, 붉은색, 검은색, 파란색이다. INDEX와 NOTE를 영문으로 기록해놓았다. 지질은 양지로서, 앞면은 매끄럽고 뒷면은 배접지같이 표면이 껄끄럽다. 인장은  (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T14:47:06Z", "prov:used": ["jsg"], "prov:endedAtTime": "2026-11-24T14:47:06Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#52837263697523b7"}]}}, {"@id": "https://jsg.aks.ac.kr/dir/view?dataId=JSG_K2-4578", "@type": "rico:Record", "rico:title": "조선지형도(朝鮮地形圖)", "rico:identifier": "K2-4578", "rico:isOrWasIncludedIn": {"@id": "set:jsg:四部 › 史部(K2)"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#agency/%EC%A