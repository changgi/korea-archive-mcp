8OC39ada0SwbTNU9jmudpaFcRcbHICfPM9dJyWbOKLCEmkmJKSktJWZRFSZSE1UoeAWsI4He90X1AeMuHQYNgR3B-iSlt8vF4b3pKkqYS8oKYViVFlRW69QE/manifest.json", "@type": "rico:Instantiation", "rico:title": "기록 봉투(이미지 없음 — 기록 정보만 담은 브리지)"}, "rico:scopeAndContent": "서울 경국사慶國寺 극락전極樂殿의 내부 사진이다. 베버 총아빠스의 저서 『고요한 아침의 나라』에 1911년 4월 2일 경국사를 방문한 내용이 남아 있어 촬영 시기 역시 같은 날로 추정된다. 1684년에 제작된 목각탱木刻幀과 아미타삼존불을 중심으로 우측에는 1887년에 제작된 <팔상도八相圖>가 걸려 있으며 그 옆으로는 현재 동국대학교박물관에 소장된 <현왕도現王圖>가 확인된다. 이 사진은 경국사 극락전의 불상과 불화 배치를 확인할 수 있는 자료로 중요한 의미가 있다. (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T07:19:39Z", "prov:used": ["okchf"], "prov:endedAtTime": "2026-11-23T13:40:53Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.overseaschf.or.kr/archive/search/category.do?mode=view&srSearchTy=relic&id=130144&iDivCd=2", "@type": "rico:Record", "rico:title": "[국외문화유산] 고려사절요 — 미국 하와이주립대학교 해밀턴도서관", "rico:identifier": "relic:130144", "rico:isOrWasIncludedIn": {"@id": "set:okchf:국외소재문화유산재단 › 국외문화유산 › 미국 › 하와이주립대학교 해밀턴도서관"}, "rico:hasOrHadHolder": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%EB%AF%B8%EA%B5%AD"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%ED%95%98%EC%99%80%EC%9D%B4%EC%A3%BC%EB%A6%BD%EB%8C%80%ED%95%99%EA%B5%90%20%ED%95%B4%EB%B0%80%ED%84%B4%EB%8F%84%EC%84%9C%EA%B4%80"}], "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/1932"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%EC%A0%84%EC%A0%81"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%EC%82%AC%EB%B6%80%28%E5%8F%B2%E9%83%A8%29"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%ED%8E%B8%EB%85%84%EB%A5%98%28%E7%B7%A8%E5%B9%B4%E9%A1%9E%29"}], "rdfs:seeAlso": {"@id": "https://changgi.github.