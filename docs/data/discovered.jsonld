rchive-mcp/data/subjects.jsonld#holder/University%20of%20Birmingham%3A%20Cadbury%20Research%20Library%3A%20Special%20Collections"}], "rico:hasCreator": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#creator/Korean%20Mission"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#creator/The%20Korean%20Mission%20Partnership"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/e77910bd8804.html"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/tna/a8227b8e/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 이미지로 구축(KOREA ARCHIVE 브리지)"}, "rico:scopeAndContent": "Records of the Korean Mission deposited by the Mission's home office, which reflect the role of the Organising Secretary as the central point of contact for Mission staff. Includes minutes of the Central and Executive Committees, 1900-1979; ledgers and cash books, 1949-1967; indexes of financial contributors to the work of the Mission; indexes of orphans and 'adopters', involved in the Mission's sponsorship scheme; correspondence files; Korean bibles, scripture, liturgy, prayer and hymn books; printed material including annual reports, 1889-1910, and issues of the Mission's quarterly magazine ", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:56:57Z", "prov:used": ["tna"], "prov:endedAtTime": "2026-11-24T22:56:57Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#ef95123cfb100eff"}]}}, {"@id": "https://archive.org/details/9780812248456", "@type": "rico:Record", "rico:title": "9780812248456", "rico:identifier": "9780812248456", "rico:isOrWasIncludedIn": {"@id": "set:ia:IA Collection › opensource_image"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#m