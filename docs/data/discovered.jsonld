ownes"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/W%20W%20%28Sergeant%29"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/active%201953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Farmers"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Korea"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Korean%20War"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/1950-1953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Koreans"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Rice"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Vehicles"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Military"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/TVA9SwNBEP0rw9ZJ7sucyXURC0XRgCeCIcXe3d4H2eyec3tqIoJCCksLO0Vs7CzE0p9jae5HOCcIMsXMe_NmHrwrVrFgwhK1ZNMOMyxgk6PMwAnVtr5QooJcyLJQGXDY0yi4gpTjXCDEUnAktuQmB5OjrrMcEly0WixiAZXhclZBqluVwTqegU5hC8aSG63VFL5uHmAkxSVXCeuwhLx9OIyNjui7M-x7RBZEuu7A3xwOfII1wdyYMrAsxY0sol6mz01PLS0Uscaksv6JSxIfnJLL558L_Q1rVFEtJewXEXJc_K7D0fh4Z5dOFJ20UXTYnCZqZ9TW70_fH2-wvls1L7fQPN43z6-04m1Yru36Xcfpul7oeMGGHfRtdv0D/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "6 October 1953. Sgt. W W Downes, of Nelson, helps the old Korean farmer clear the track through the rows of drying rice stalks for the passage of a \"B\" platoon truck to the hill area beyond the farm. A couple of cigarettes and a hand with the crop generally gets good co-operation from the local people and no hard feelings after the passage of a war convoy has disturbed their peaceful routine Quantity: 1 b&w original photographic print(s).", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:50Z", "prov:used": ["dnz"], "prov:endedAtTime": "2026-11-23T13:40:50Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "http://natlib.govt.nz/records/22898683", "@type": "rico:Record", "rico:title": "New Zealand soldiers with Korean soldiers attached to Commonwealth units (KATCOMS) — Alexander Turnbull Library·TAP", "rico:identifier": "22898683", "rico:isAssociatedWithDate": "1953", "rico:isOrWasIncludedIn": {"@id": "set:dnz:NZ › Alexander Turnbull Library › TAPUHI"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Coleman"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/J%20G%20%28Signalman%29"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/active%201953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Clark"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/E%20J%20%28Mr%29"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/active%201953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Roebuck"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/active%201953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Robertson"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/P%20M"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/active%201953"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/KATCOMS"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Korean%20War"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/1950-1953"}, {"@id"