-23T10:15:35Z", "prov:used": ["nrich"], "prov:endedAtTime": "2026-11-23T10:15:35Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://portal.nrich.go.kr/kor/originalUsrView.do?menuIdx=1046&info_idx=275", "@type": "rico:Record", "rico:title": "[발간자료] 조선시대초상화학술심포지엄자료집", "rico:identifier": "rep:275", "rico:isAssociatedWithDate": "2007", "rico:isOrWasIncludedIn": {"@id": "set:nrich:국립문화유산연구원 › 발간자료 › 미술 › 미술사"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%EC%A1%B0%EC%82%AC%EC%97%B0%EA%B5%AC%EB%B3%B4%EA%B3%A0%EC%84%9C"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/fZDLSsNQEIZfJZyFqzS3mhYC4rqLrrxsSinBJukhV09TFERIaxcFC1ZQSjGUiGg3EYNYKIIv47KZvoNj66Ird_8_c-ab_8wFaROtRjxGT1qkzpOQaKSWZ_Ey68N0lD8N6xw8ZtBP4DrOhxF8DOCqu5rcre4nMMBiurpJYRbB-O85zG4JT5pIUSSpjJKiZEagKWUVXQddKwyDtiaKgc9C3RHWqwXLF2wm2j4TfUYt6unOUZsdU-NMaPr7ruF1Ks3zPVnaLe1Qz_QbFN2GGCBxOX_NX77ydIHBIE6gl8E4W85TeBhx39Ent_2fTeFtgem3JPRSZHnI2lyCJ-7_SU3qGA2HerZYcXXLEKvVA7koWNTE0VMc_V35nnL5oA9Jl8MgMH3Glh6uL6OUCrJcUIqHsqTJqlZUyeUP/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "이 책자는 국립문화재연구소(현 국립문화유산연구원)가 2007년 11. 30(금) 주최한 ‘조선시대 초상화 학술 심포지엄’ 개최 시 발표자의 논문을 요약하여 행사 당일, 참석자에 한하여 배부하기 위해 제작한 자료집 입니다. 참고 : 행사 개요 “조선시대 초상화 학술심포지움”- 다시보는 우리의 초상화... (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T10:15:35Z", "prov:used": ["nrich"], "prov:endedAtTime": "2026-11-23T10:15:35Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://portal.nrich.go.kr/kor/originalUsrView.do?menuIdx=1046&info_idx=297", "@type": "rico:Record", "rico:title": "[발간자료] 다시보는우리초상의세계-조선시대초상화학술논문집", "rico:identifier": "rep:297", "rico:isAssociatedWithDate": "2007", "rico:isOrWasIncludedIn": {"@id": "set:nrich:국립문화유산연구원 › 발간자료 › 미술 › 미술사"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%EC%A1%B0%EC%82%AC%EC%97%B0%EA%B5%AC%EB%B3%B4%EA%B3%A0%EC%84%9C"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/fZDLTsJAFIZfpZmFK-iNi7GJcc2ClZcNIaSRUkZKW4cSTYwJYE2IsMAEoyiSGhU3NTYCCTH6Mi47h3dwoBtW7v5_zpz_fOecoRpScsgk-LCM8jHkIAXlaDAMAxdGPfrczXO08wKdIZ1M6VUf7gM69mHahosmPN6BOw8nbhyeAnC95aduI6otBv3FzQDaHr38pv4c3q5RDBVZtiyKm0xiJolmK_LW0tWZKzuOXVMEwbaIoxr8CojXLb5ChIpFBItgHZuqsV8jB1g74YvWTlUz65ni6bYkJtMb2CxZBcxclGizxHD2Tsc_bDqDgaEHrQBug3Dmw0OP-218cetbRg8fc0a8JqHlsyyTZUX3iaHq_6QlbGgFA5sVIVNVdU3IZnelJH9k66z1mLUuR376HG274DU5BgKjV1ZSndVl5HRckuJyYk8SFSmlJFLo_A8/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "본 책자는 2007년 1월 30일 국립문화재연구소(현 국립문화유산연구원)가 개최한 ‘다시 보는 우리 초상의 세계-조선시대 초상화 학술심포지엄’에서 발표한 6편이 논문과 질의문, 당시 종합토론 내용을 수정하여 수록한 학술논문집이다. 주요 내용은 조선시대 어진의 제작과 봉안, 17세기 공신상의 도상 변화, 18~19세기 사대부 초상화의 양상과 변모, 조선후기 ... (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T10:15:35Z", "prov:used": ["nrich"], "prov:endedAtTime": "2026-11-23T10:15:35Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://portal.nrich.go.kr/kor/originalUsrView.do?menuIdx=1046&info_idx=351", "@type": "rico:Record", "rico:title": "[발간자료] 최후의진전-창덕궁신선원전", "rico:identifier": "rep:351", "rico:isAssociatedWithDate": "2010", "rico:isOrWasIncludedIn": {"@id": "set:nrich:국립문화유산연구원 › 발간자료 › 미술 › 미술사"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#class/%EC%A1%B0%EC%82%AC%EC%97%B0%EA%B5%AC%EB%B3%B4%EA%B3%A0%EC%84%9C"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/fZAxS8NAGIb_SrjBqc3dJWmhAXETuqtLKSWYND2aXuI1pYIItmQoqNBBUWktAVGXiEGoFKF_xjG5_ge_tksnb3rf77jn3u-9QF1k1hAX7LSF6gUUIhPV8nSapZGcjfOXm7oi59PVJJLPj_I9knFUlOkyv73PvgfyOpZRLCdjmKICsuGpRigByUAKJzD1EgXXA9cKw6BrYhz4IrQ8dfOf6vpqW-C2L7AvmMu45R13xQlz-qrtH3Qc3qva5_uUGOU9xpt-g4HbEgMgZvOP_G2ZJ4vV052cxnKYyoc0myeQR_m9-lF2l9gOPhdyFO9IOUyAxYG1Xb-AOv8nbTLPaXiMtzF3-oe-ZzsC00oFVzuW62CNaDoxiEFLOiEVapQbBA5VA-4C-gzQ60hfiZKPoMeBsi5u9gpXVrhpTisXKS1q-hElJi1Bd-jyDw/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "이 도록은 현존하는 유일의 진전(眞殿: 국왕의 초상을 보관한 전각)인 창덕궁 신선원전(新璿源殿)의 역사적 의의를 조명한 책자이다. 신선원전 내외부 전경, 관련 유물의 화보, 참고자료 등을 수록하며 미공개 지역인 신선원전에 대한 상세한 정보와 향후 학술연구의 기초자료를 제공하고자 하였다. (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T10:15:35Z", "prov:used": ["nrich"], "prov:endedAtTime": "2026-11-23T10:15:35Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.europeana.eu/item/2022039/11088_de_bo133_52047", "@type": "rico:Record", "rico:title": "Korea-Verhandlungen zweiter Teil", "rico:identifier": "/2022039/11088_de_bo133_52047", "rico:isAssociatedWithDate": "1953", "rico:isOrWasIncludedIn": {"@id": "set:europeana:Europeana › Library of the Friedrich Ebert Foundation"}, "rico:hasOrHadInstantiation": {"@id": "https://iiif.europeana.eu/presentation/2022039/11088_de_bo133_52047/manifest", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:45Z", "prov:used": ["europeana"], "prov:endedAtTime": "2026-11-23T13:40:45Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.europeana.eu/item/2059218/data_sounds_IT_DDS0000069047000000", "@type": "rico:Record", "rico:title": "Korea : korean music", "rico:identifier": "/2059218/data_sounds_IT_DDS0000069047000000", "rico:isOrWasIncludedIn": {"@id": "set:europeana:Europeana › Internet Culturale"}, "rico:hasOrHadSubject": [{"@id": "htt