 von Korea", "rico:identifier": "/1584/item_3YUU5MVEAK74QWQ3ZZZEU5RWVSODDC6K", "rico:isAssociatedWithDate": "1887", "rico:isOrWasIncludedIn": {"@id": "set:europeana:Europeana › Württemberg State Library"}, "rico:hasOrHadInstantiation": {"@id": "https://iiif.europeana.eu/presentation/1584/item_3YUU5MVEAK74QWQ3ZZZEU5RWVSODDC6K/manifest", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "rico:scopeAndContent": "ownership: Württemberg. Karten- und Plan-Cabinet", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T07:26:10Z", "prov:used": ["europeana"], "prov:endedAtTime": "2026-11-23T13:40:45Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.europeana.eu/item/440/item_SXNBOOSPFREXU5ZL3ARD7UTNINHVKP4N", "@type": "rico:Record", "rico:title": "Fusan (Korea)", "rico:identifier": "/440/item_SXNBOOSPFREXU5ZL3ARD7UTNINHVKP4N", "rico:isOrWasIncludedIn": {"@id": "set:europeana:Europeana › Deutsche Fotothek"}, "rico:hasOrHadInstantiation": {"@id": "https://iiif.europeana.eu/presentation/440/item_SXNBOOSPFREXU5ZL3ARD7UTNINHVKP4N/manifest", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "rico:scopeAndContent": "Fusan (Korea)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T07:26:10Z", "prov:used": ["europeana"], "prov:endedAtTime": "2026-11-23T13:40:45Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.europeana.eu/item/463/item_ONVY6BLZMZ7JJRPDQVEA7B3J54IXZAA5", "@type": "rico:Record", "rico:title": "Korea", "rico:identifier": "/463/item_ONVY6BLZMZ7JJRPDQVEA7B3J54IXZAA5", "rico:isOrWasIncludedIn": {"@id": "set:europeana:Europeana › Deutsche Fotothek"}, "rico:hasOrHadInstantiation": {"@id": "https://iiif.europeana.eu/presentation/463/item_ONVY6BLZMZ7JJRPDQVEA7B3J54IXZAA5/manifest", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "ri