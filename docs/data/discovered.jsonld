skIBgEgQE6IoCDJxVjgOr65y0id3Csrx3LAkSTKEsVGSltFcSZf6s0wCTczChy2j9lnB0MmbxkIPesMUjHJFtE-GRUhDFgiRXhbIqllRJQZdf/manifest.json", "@type": "rico:Instantiation", "rico:title": "기록 봉투(이미지 없음 — 기록 정보만 담은 브리지)"}, "rico:scopeAndContent": "뚜껑이 없는 대형 원형반이다. 내면 중앙에 뇌문(雷文)을 돌리고 그 안에 매화와 잉어를 시문했다. 외면은 여덟 칸으로 구획하여 순서대로 ① 대나무와 토끼 ②꽃과 새 ③ 연꽃이 핀 연못의 거북이 ④ 천도복숭아, 영지(靈芝)와 쌍학 ⑤ 대나무와 죽순(竹筍) ⑥ 소나무와 초승달, 영지, 사슴 ⑦ 매화나무에 앉은 새 ⑧ 연꽃이 핀 연못의 원앙 등을 시문했다. 전복껍데기를 가공하고 한국 특산인 분홍빛이 도는 색패를 주름질과 끊음질로 곱게 잘라 구획선과 대나무, 풀 등을 표현했다. 나전 표면에 가는 선으로 문양을 새긴 살치기 기법이 돋보인다. 그릇의 형태는 통나무를 파서 얇게 만들고, 옆면과 아랫부분의 모서리는 곡선으로 다듬었다. 바닥 부분은 반구형 낮은 다리를 세 개 붙였다. 나전 가공, 상감 기술, 문양의 표현 등 (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T08:15:26Z", "prov:used": ["okchf"], "prov:endedAtTime": "2026-11-23T08:40:58Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.overseaschf.or.kr/archive/search/category.do?mode=view&srSearchTy=relic&id=46491&iDivCd=1", "@type": "rico:Record", "rico:title": "[국외문화유산] 용문화각합 — 미국 클리블랜드미술관", "rico:identifier": "relic:46491", "rico:isOrWasIncludedIn": {"@id": "set:okchf:국외소재문화유산재단 › 국외문화유산 › 미국 › 클리블랜드미술관"}, "rico:hasOrHadHolder": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%EB%AF%B8%EA%B5%AD"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%ED%81%B4%EB%A6%AC%EB%B8%94%EB%9E%9C%EB%93%9C%EB%AF%B8%EC%88%A0%EA%B4%80"}], "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/20%EC%84%B8%EA%B8%B0"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#material/%EB%82%98%EB%AC%B4%20%3E%20%EA%B8%B0%ED%83%80"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#material/%EA%B3%A8%EA%B0%81%ED%8C%A8%EA%B0%91%20%3E%20%EC%88%98%EA%B0%81"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-m