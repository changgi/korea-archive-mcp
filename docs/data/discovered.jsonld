o:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/%EC%A1%B0%EC%84%A0%20%ED%83%9C%EC%A1%B0%207%EB%85%84%281398%29"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/heritage/11-0000010000000-11/manifest.json", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "rico:scopeAndContent": "조선시대 한양도성의 정문으로 남쪽에 있다고 해서 남대문이라고도 불렀다. 현재 서울에 남아 있는 목조 건물 중 가장 오래된 것으로 태조 5년(1396)에 짓기 시작하여 태조 7년(1398)에 완성하였다. 이 건물은 세종 30년(1448)에 고쳐 지은 것인데 1961∼1963년 해체·수리 때 성종 10년(1479)에도 큰 공사가 있었다는 사실이 밝혀졌다. 이후, 2008년 2월 10일 숭례문 방화 화재로 누각 2층 지붕이 붕괴되고 1층 지붕도 일부 소실되는 등 큰 피해를 입었으며, 5년 2개월에 걸친 복원공사 끝에 2013년 5월 4일 준공되어 일반에 공개되고 있다. 이 문은 돌을 높이 쌓아 만든 석축 가운데에 무지개 모양의 홍예문을 두고, 그 위에 앞면 5칸·옆면 2칸 크기로 지은 누각형 2층 건물이다. 지붕", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:49Z", "prov:used": ["heritage"], "prov:endedAtTime": "2026-11-23T13:40:49Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.heritage.go.kr/heri/cul/culSelectDetail.do?ccbaCpno=2113603510000", "@type": "rico:Record", "rico:title": "담양 몽한각 소장 숭례문과 후적벽부 목판(潭陽 夢漢閣 所藏 崇禮門과 後赤壁賦 木板) [시도유형문화유산] — 전남광주 담양군", "rico:identifier": "21-0003510000000-36", "rico:isOrWasIncludedIn": {"@id": "set:heritage:지정 › 시도유형문화유산"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/1887%EB%85%84%28%EA%B3%A0%EC%A2%8524%29"}], "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/heritage/21-0003510000000-36/manifest.json", "@type": "rico:Instantiation", "rico:title": "기관 매니페스트"}, "rico:scopeAndContent": "○ 양녕대군 이제(1394~1462)의 친필로 전해지고, 후손들이 서울 지덕사 소장본을 모본으로 하여 1887년(고종24) 9월 몽한각에서 다시 판각한 인출본 목판으로 서예사 연구의 학술적 예술적 가치가 탁월함 ○ 숭례문 목판은 현 국보 '서울 숭례문' 현판보다도 자형과 필획이 균형을 이루고, 후적벽부 목판은 초서의 정형성을 탈피하여 자유분방하면서도 기운이 약동하는 서격과 물 흐르듯 써 내려간 광초의 필적", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:49Z", "prov:used": ["heritage"], "prov:endedAtTime": "2026-11-23T13:40:49Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://search.i815.or.kr/contents/newsPaper/detail.do?newsPaperId=GM1948061604-01&sortNo=8", "@type": "rico:Record", "rico:title": "[신문자료] 안중근 의사 조카 도미", "rico:identifier": "GM1948061604-01", "rico:isOrWasIncludedIn": {"@id": "set:i815:자료 › 신문자료"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/q1YqVrKKVsq0MDRVitVRKlGyUop-073g9Zodb-ZNeL24J1bhzdSON0smvtq-R-HN3BlvmtYovFm44c3OLQqv-1ter9-hpKOUAtQDpDKBlLuvoaWJhYGZoZmBia6BIVC0FCiaUVJSUGylr1-cmliUnKEHsksvv0gvu0g_OT-vJDWvpFg_L7W8OCCxILVIPyW1JDEzRy8l3x4u5plii2awWnF-UYlfvq0F0IYCoA0Qtyo8atilgOx4oGweUBbsOR2lXIg7C4HU6w1zXm1ao_C6o-XNgkaFN7MnvJm3FCiVCPK-kYGRma6hoa6RcYihsZWJgZWJpVItAA/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "상해(上海)에 다년 거류하던 고 안중근공의 질녀 수산아양이 미주 유학차로 건너오는 길에 지난 9일 호놀룰루에 잠시 상륙하여 본사와 기독교회를 심방(尋訪)한 바, 기독교회에서는 환영회가 있었다 한다. 안양은 의화단 배상조의 유학생으로 당선되어 관비생으로 도미(渡美)케 되었다더라. (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:49Z", "prov:used": ["i815"], "prov:endedAtTime": "2026-11-23T13:40:49Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://search.i815.or.kr/contents/newsPaper/detail.do?newsPaperId=GM1952041604-01&sortNo=8", "@type": "rico:Record", "rico:title": "[신문자료] 조선을 떠나며 부른 안중근의 작별가", "rico:identifier": "GM1952041604-01", "rico:isOrWasIncludedIn": {"@id": "set:i815:자료 › 신문자료"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/XVC9SsNQGH2Vyzc45e-maWkDxVEcFAe30iE0gQY1iblXHESIkqGgQzsoBW2IaAehQ1DQIj6NY-73EH61IOJ04Bw4f2cgwO1B2OZN6GsgwYUeXpVqscRirB6v-wwfKsxLnOVM3ZbqcqqeK6beMjVfMrwZ4dOkfv_E2ZRhMVGveV1loIFPNgQhwdYO7zRty-Ety9EtTuwJsUMpE-Gapgi8dDA0VvFGnBoHqTmIIxlEUphRcCr2vCRITT-QXnho-PHmL7ftd_8Zb4g4lbtxt00JCSWs67Ov7IP93UNqROrPXg2O1j2PCVR1X78smBrlWF4wvBtjMSfJWz1iW3ZL51y3G_u84TqW63Tg_Bs/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "나는 간다 삼천리 강산 너 잘있어 이천만 민족 잘 보호하라 잘 보호하라 나는 이천만 민족의 자유를 위해 희생한다. 이천만 민족의 국혼 영원히 살아있어 왜적 원수를 토멸하라. 나는 눈물로 작별한다. 나는 이천만 동포 아름다운 금수강산 위해 나는 눈물로 작별한다 이 안중근 의사를 사랑하시는 친구님께 드립니다. 오십년 전에 부르던 작별가 심영신 (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:49Z", "prov:used": ["i815"], "prov:endedAtTime": "2026-11-23T13:40:49Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://search.i815.or.kr/contents/newsPaper/detail.do?newsPaperId=SH1910031504-04&sortNo=8", "@type": "rico:Record", "rico:title": "[신문자료] 공판 후의 안중근 씨", "rico:identifier": "SH1910031504-04", "rico:isOrWasIncludedIn": {"@id": "set:i815:자료 › 신문자료"}, "rico:hasOrHadInstantiation": {"@id": "https://korea-archive-mcp.vercel.app/iiif/rec/q1YqVrKKVsq0MDRVitVRKlGyUop-073g9Zodb-ZNeL24J1bh1eatb3smKLyd3fJm7gyFN1M73iyZ-Gr7HoU3U1Yo6SilADUAqUwgFexhaGloYGBsaGpgomtgAhQtBYpmlJQUFFvp6xenJhYlZ-iBLNLLL9LLLtJPzs8rSc0rKdbPSy0vDkgsSC3ST0ktSczM0UvJt4eLeabYohmsVpxfVOKXb2sBtKEAaAPEoQqPGnYpILscKJsHlAX7TEcpF-LOQiD1esOcV5vWKLzuaHmzoFHhzewJb-YtBUolgvxuZGBkpmtoqGtkHGJobGViYGViqVQLAA/manifest.json", "@type": "rico:Instantiation", "rico:title": "브리지 매니페스트(기록 봉투)"}, "rico:scopeAndContent": "일본 변호사 슈야란 자가 여순 감옥에서 안중근 씨를 방문하고 공소여부를 물으니 안 씨의 말이 재판에는 불복하나 목숨을 아끼어 공소한다고 세상 사람이 지목하겠은즉 이윽고 생각한 후에 결심하리라고 대답하였으나 아마 공소는 아니할 듯 하고 또 슈야가 안중근 씨의 모친이 가문의 이름을 더럽게 말라 하였다는 말이 신문에 게재되었다 한즉, 안 씨는 그 모친에 고명의견에 감읍함을 마지아니하노라 하였더라. (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T13:40:49Z", "prov:used": ["i815"], "prov:endedAtTime": "2026-11-23T13:40:49