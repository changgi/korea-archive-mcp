LdvwDz3eoFTEaZ8LgOB0XW1bqn2GOlUZk2BGLDh1LhawGZP1giOtbMZ3vwmy2N48A8SH9JU3lLdtvu8tXB-uf98oi718k1_codggnmHBOAMpQYOH0wpi7Te-kTlgNa4qmK3nVUA1d1xTdKMhnjQoEnENAspisX-ZS0u-JWUcSdwMxfYAR2fwVnMvnVDWn6UWlYBqKuVdAl98/manifest.json", "@type": "rico:Instantiation", "rico:title": "기록 봉투(이미지 없음 — 기록 정보만 담은 브리지)"}, "rico:scopeAndContent": "끊음질로 기하학적인 장식을 한 나전상자이다. 직선문양을 뚜껑과 몸체의 운두까지 연결되게 장식하였고 뚜껑에는 4언 절구를 나전으로 시문하였다. 글귀의 내용으로 보아 벼루상자임을 알 수 있다. 염색공예가이자 민예운동에 참여했던 세리자와 게이스케芹沢銈介, 1895-1984가 1984년 기증한 유물이다. (KOREA ARCHIVE 심층 판독 nedb_search)", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-23T08:40:58Z", "prov:used": ["okchf"], "prov:endedAtTime": "2026-11-23T08:40:58Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"]}}, {"@id": "https://www.overseaschf.or.kr/archive/search/category.do?mode=view&srSearchTy=relic&id=47070&iDivCd=1", "@type": "rico:Record", "rico:title": "[국외문화유산] 나전서안 — 일본 일본민예관", "rico:identifier": "relic:47070", "rico:isOrWasIncludedIn": {"@id": "set:okchf:국외소재문화유산재단 › 국외문화유산 › 일본 › 일본민예관"}, "rico:hasOrHadHolder": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%EC%9D%BC%EB%B3%B8"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#holder/%EC%9D%BC%EB%B3%B8%EB%AF%BC%EC%98%88%EA%B4%80"}], "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/%EC%A1%B0%EC%84%A0"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#period/19%EC%84%B8%EA%B8%B0"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#material/%EB%82%98%EB%AC%B4%20%3E%20%EA%B8%B0%ED%83%80"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#material/%EA%B3%A8%EA%B0%81%ED%8C%A8%EA%B0%91%20%3E%20%EB%82%98%EC%A0%84"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/a16e7811335a.html"}, "rico:isRelatedTo": [{"@id": "https://c