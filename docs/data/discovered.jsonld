s.jsonld#subject/%2ACLOSE%20SUPPORT"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/NAVY"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/AIRBORNE"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/ATTACK"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/TACTICAL"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/aa20a918a076.html"}, "rico:isRelatedTo": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/r/4cdd874b2e45.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › dticarchive'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/a1f22ccccfea.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › dticarchive'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/27c71286e7ed.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › dticarchive'"}], "rico:hasOrHadInstantiation": {"@id": "https://iiif.archive.org/iiif/3/DTIC_ADA242405/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 제공 매니페스트"}, "rico:scopeAndContent": "This study investigates the roles that each Service played in support of the successful evacuation of the U.S. X Corps from the port of Hungnam in December of 1950. The concept presented is one that emphasizes the unique capabilities of each Service while concentrating on the necessity for complimentary support in order to achieve overall success. The evacuation of X Corps incorporated a variety o", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:40:42Z", "prov:used": ["ia"], "prov:endedAtTime": "2026-11-24T22:40:42Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#df49b94c2a73a9dc"}]}}, {"@id": "https://archive.org/details/t3wXp7NIGMTGQvUfLLEtBtKYxxIEfc", "@type": "rico:Record", "rico:title": "\"THAT WAR IN KOREA \" KOREAN WAR DOCUMENTARY 1950 INVASION TO HUNGNAM EVACUATION PART 1 6344", "rico:identifier": "t3wXp7NIGMTGQvUfLLEtBtKYxxIEfc", "rico:isOrWasIncludedIn": {"@id": "set:ia:IA Collection › PeriscopeFilm"}, "rico:hasOrHadSubject": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#medium/movies"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#subject/Stock%20Footage"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/520d14ad9dc4.html"}, "rico:isRelatedTo": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/r/21f6823a94fd.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › PeriscopeFilm'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/3a0e763a5667.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › PeriscopeFilm'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/274d28000325.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 'IA Collection › PeriscopeFilm'"}], "rico:hasOrHadInstantiation": {"@id": "https://iiif.archive.org/iiif/3/t3wXp7NIGMTGQvUfLLEtBtKYxxIEfc/manifest.json", "@type": "rico:Instantiation", "rico:title": "원 기관 제공 매니페스트"}, "rico:scopeAndContent": "Encyclopedia Britannica (:41) presents \"That War in Korea\", a documentary about the Korean War of 1950 to 1953. Originally produced as a Project XX documentary. The film opens with USS Pickaway (:55). Pickaway shuttled US troops from Japan to Pusan. US soldiers bid wives and families goodbye at the start of the war (1:02). Wounded are drug across land (1:47). A funeral service follows (1:57). Rich", "prov:wasGeneratedBy": {"@type": "prov:Activity", "prov:label": "KOREA ARCHIVE 통합검색 발견", "prov:startedAtTime": "2026-11-24T22:40:42Z", "prov:used": ["ia"], "prov:endedAtTime": "2026-11-24T22:40:42Z", "prov:wasAssociatedWith": ["KOREA ARCHIVE 통합검색/cross_search"], "prov:wasInformedBy": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/provenance.json#df49b94c2a73a9dc"}]}}, {"@id": "https://www.koreanwar.or.kr:8443/searchDetail.do?archRfcd=1990-US-01-PF-A-00022", "@type": "rico:Record", "rico:title": "흥남철수작전 당시 폭파되는 흥만 항구 시설 사진", "rico:identifier": "1990-US-01-PF-A-00022", "rico:isAssociatedWithDate": "1950-12-24", "rico:isOrWasIncludedIn": {"@id": "set:koreanwar:협약 › 기증 > 미국 > 해군 > 군사감실"}, "rico:hasCreator": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/subjects.jsonld#creator/%EB%AF%B8%20%ED%95%B4%EA%B5%B0%28U.S.%20Navy%29"}], "rdfs:seeAlso": {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/833ed396c08d.html"}, "rico:isRelatedTo": [{"@id": "https://changgi.github.io/korea-archive-mcp/data/r/593854222d9f.html", "rdfs:comment": "같은 날(다른 기관) — 기관 표기 날짜 1950-12-24"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/c37463a10a1a.html", "rdfs:comment": "같은 날(다른 기관) — 기관 표기 날짜 1950-12-24"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/3e86e968de49.html", "rdfs:comment": "같은 날(다른 기관) — 기관 표기 날짜 1950-12-24"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/b83f0b6d6b52.html", "rdfs:comment": "같은 날(다른 기관) — 기관 표기 날짜 1950-12-24"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/3dba4d7ccb7f.html", "rdfs:comment": "같은 날(다른 기관) — 기관 표기 날짜 1950-12-24"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/9492cf85f783.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '협약 › 기증 > 미국 > 해군 > 군사감실'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/b2164b592594.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '협약 › 기증 > 미국 > 해군 > 군사감실'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/b0f2b0aa3cf8.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '협약 › 기증 > 미국 > 해군 > 군사감실'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/bac246690849.html", "rdfs:comment": "같은 계열 — 같은 기관 계층 '협약 › 기증 > 미국 > 해군 > 군사감실'"}, {"@id": "https://changgi.github.io/korea-archive-mcp/data/r/1365029cfe88.html", "rdfs:comment": "같은 계열